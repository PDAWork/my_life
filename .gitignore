# OS and temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.pyc
*.swp
*.swo
*~

# Editor caches and local project metadata
*.iml
*.ipr
*.iws
.idea/
.atom/
.history/
.svn/

# Shared .run/ and .vscode/ configurations remain versioned.

# Compiled Java files
*.class

# Dart / Flutter / Pub caches (including feature packages)
**/.dart_tool/
**/.pub-cache/
**/.pub/
**/.packages
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.widget_preview/
**/ios/Flutter/.last_build_id
**/doc/api/

# Build and test outputs for all workspace packages
**/build/
**/coverage/
.build/
.buildlog/
migrate_working_dir/

# Flutter symbolication and obfuscation outputs
app.*.symbols
app.*.map.json

# Android Studio build outputs
/android/app/debug/
/android/app/profile/
/android/app/release/

# Swift Package Manager caches
.swiftpm/

# FVM SDK cache; keep .fvmrc versioned
.fvm/

# Local workspace materials
.codex/
design-reference/

# Platform-specific caches, Pods, ephemeral files and signing keys are
# covered by android/, ios/, macos/, windows/ and linux/ .gitignore files.
# Keep pubspec.lock, Podfile.lock and generated Dart sources versioned.
